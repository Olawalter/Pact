# PACT frontend configuration. Every value is public: the app reads the chain in
# the browser and signs with the visitor's own wallet. There is no secret here.
NEXT_PUBLIC_GENLAYER_NETWORK=studionet
NEXT_PUBLIC_GENLAYER_CHAIN=61999
# The deployment of record (docs/deployment.json), byte-verified against contracts/PACT.py
NEXT_PUBLIC_PACT_CONTRACT_ADDRESS=0xDB2EcD9fcACfa3B639de3a8b8d91De30A746233f
# Optional: another StudioNet RPC endpoint. Defaults to https://studio.genlayer.com/api
# NEXT_PUBLIC_GENLAYER_RPC_URL=
